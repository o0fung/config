# Shared Git defaults. This file intentionally contains no identity, tokens,
# credential helpers, or editor command: those are personal or platform-specific.
[alias]
    st = status --short --branch
    lg = log --graph --decorate --oneline
    ci = commit
    pl = pull
    ph = push
    br = branch
    sw = switch

[fetch]
    prune = true

[push]
    autoSetupRemote = true

[rebase]
    autoStash = true

[column]
    ui = auto
